---
const roles = [
  { when: 'Apr 2026 – present', role: 'AI Specialist', org: 'A Philippine digital bank', note: 'LLM agents, MCP infrastructure, compliance and fraud automation, model cost strategy.' },
  { when: 'May – Oct 2026', role: 'AI Business Analyst (Contract)', org: 'A US swim-school operations SaaS', note: 'Requirements to code: data integration and rollout guardrails for 7 locations.' },
  { when: 'Jul 2025 – Mar 2026', role: 'AI Automation & Business Systems Specialist', org: 'Bloomsocial Inc.', note: 'In-house digital-signage CMS and an interactive AI kiosk.' },
];
---
<section id="experience" class="section" aria-labelledby="exp-h">
  <div class="wrap">
    <p class="eyebrow">Experience</p>
    <h2 id="exp-h">Where I've shipped.</h2>
    <ol class="tl">{roles.map((r) => (<li><span class="muted when">{r.when}</span><div><h3>{r.role}</h3><p class="org">{r.org}</p><p class="muted">{r.note}</p></div></li>))}</ol>
    <p class="muted edu">BSBA Financial Management, Cum Laude · 2025</p>
  </div>
</section>
<style>
  .tl { list-style: none; padding: 0; margin: 28px 0 0; }
  .tl li { display: grid; grid-template-columns: minmax(140px, 200px) 1fr; gap: 8px 32px; padding: 20px 0; border-bottom: 1px solid var(--border); }
  @media (max-width: 560px) { .tl li { grid-template-columns: 1fr; } }
  .when { font-size: .9rem; padding-top: 4px; }
  .org { font-weight: 600; margin-bottom: 4px; }
  .tl p { margin-bottom: 0; }
  .edu { margin-top: 20px; font-size: .92rem; }
</style>
