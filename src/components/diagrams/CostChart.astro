---
// Indexed monthly model spend: before = 100, after = 26 (the ~74% reduction). No dollar amounts by policy,
// and no invented intermediate points — only the two measured values are shown.
const bars = [{ label: 'Before migration', v: 100 }, { label: 'After migration', v: 26 }];
const W = 640, H = 220, L = 150, R = 70, barH = 56, gap = 34, T = 30;
const w = (v: number) => ((W - L - R) * v) / 100;
---
<figure class="chart">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="cc-t cc-d" font-family="var(--sans)">
    <title id="cc-t">Monthly model spend, indexed</title>
    <desc id="cc-d">Monthly model spend indexed to 100 before the migration falls to 26 after it, a reduction of about 74 percent.</desc>
    {bars.map((b, i) => (
      <g>
        <text x={L - 14} y={T + i * (barH + gap) + barH / 2 + 5} text-anchor="end" font-size="14" fill="currentColor">{b.label}</text>
        <rect x={L} y={T + i * (barH + gap)} width={w(b.v)} height={barH} rx="8" fill={i === 0 ? 'var(--border)' : 'var(--accent)'} />
        <text x={L + w(b.v) + 10} y={T + i * (barH + gap) + barH / 2 + 6} font-size="16" font-weight="700" fill={i === 0 ? 'var(--muted)' : 'var(--accent)'}>{b.v}</text>
      </g>
    ))}
    <text x={L + w(26) + 50} y={T + barH + gap + barH / 2 + 6} font-size="16" font-weight="700" fill="var(--accent)">−74%</text>
  </svg>
  <figcaption class="muted">Monthly model spend, indexed (before = 100).</figcaption>
  <table class="sr-only"><caption>Indexed monthly model spend</caption><tbody>{bars.map((b) => <tr><th scope="row">{b.label}</th><td>{b.v}</td></tr>)}</tbody></table>
</figure>
<style>
  .chart { margin: 0; }
  figcaption { font-size: .85rem; margin-top: 8px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
