---
import Box from './Box.astro';
---
<svg viewBox="0 0 760 330" role="img" aria-labelledby="mcp-t mcp-d" font-family="var(--sans)">
  <title id="mcp-t">Gated MCP server architecture</title>
  <desc id="mcp-d">LLM clients call an MCP server whose auth relay and generated tool layer forward safe calls to the bank API; high-risk calls go to a maker-checker approval queue first. All activity flows to a write-once audit trail. GitHub Actions deploys to Cloud Run through Workload Identity Federation.</desc>
  <defs><marker id="mcp-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" fill="currentColor" /></marker></defs>
  <Box x={20} y={90} w={140} h={60} label="LLM client" sub="Claude, agents" />
  <rect x="200" y="20" width="330" height="210" rx="14" fill="none" stroke="var(--accent)" stroke-width="2" />
  <text x="215" y="44" font-size="12" font-weight="600" fill="var(--accent)">MCP server · Cloud Run</text>
  <Box x={220} y={60} w={140} h={50} label="Auth relay" sub="OAuth 2.0 · PKCE" />
  <Box x={220} y={130} w={140} h={50} label="52 typed tools" sub="from OpenAPI + Zod" />
  <Box x={380} y={130} w={130} h={50} label="Approval queue" sub="maker-checker" accent />
  <Box x={590} y={130} w={150} h={50} label="Bank API" sub="sandbox" />
  <Box x={380} y={255} w={250} h={50} label="Audit trail" sub="Pub/Sub → write-once storage" />
  <Box x={20} y={255} w={300} h={50} label="GitHub Actions → WIF → Cloud Run" sub="keyless deploys" />
  <path d="M160 120 H210" stroke="currentColor" fill="none" marker-end="url(#mcp-a)" />
  <path d="M290 110 V122" stroke="currentColor" fill="none" marker-end="url(#mcp-a)" />
  <path d="M360 147 Q470 100 582 145" stroke="currentColor" fill="none" marker-end="url(#mcp-a)" />
  <text x="430" y="104" font-size="11" fill="var(--muted)">safe calls</text>
  <path d="M360 163 H372" stroke="var(--accent)" stroke-width="2" fill="none" marker-end="url(#mcp-a)" />
  <path d="M510 155 H582" stroke="var(--accent)" stroke-width="2" fill="none" marker-end="url(#mcp-a)" />
  <text x="514" y="172" font-size="11" fill="var(--muted)">approved</text>
  <path d="M445 180 V247" stroke="currentColor" stroke-dasharray="4 4" fill="none" marker-end="url(#mcp-a)" />
  <path d="M170 255 V200 H210" stroke="currentColor" stroke-dasharray="4 4" fill="none" marker-end="url(#mcp-a)" />
</svg>
