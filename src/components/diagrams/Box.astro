---
interface Props { x: number; y: number; w: number; h: number; label: string; sub?: string; accent?: boolean }
const { x, y, w, h, label, sub, accent = false } = Astro.props;
---
<g>
  <rect x={x} y={y} width={w} height={h} rx="10" fill="var(--surface)" stroke={accent ? 'var(--accent)' : 'currentColor'} stroke-width={accent ? 2 : 1.2} />
  <text x={x + w / 2} y={sub ? y + h / 2 - 4 : y + h / 2 + 5} text-anchor="middle" font-size="14" font-weight="600" fill="currentColor">{label}</text>
  {sub && <text x={x + w / 2} y={y + h / 2 + 15} text-anchor="middle" font-size="11" fill="var(--muted)">{sub}</text>}
</g>
