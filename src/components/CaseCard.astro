---
interface Props { id: string; title: string; summary: string; metric: { value: string; label: string }; stack: string[] }
const { id, title, summary, metric, stack } = Astro.props;
---
<a class="card case" href={`/work/${id}/`}>
  <span class="num metric">{metric.value}</span>
  <span class="muted label">{metric.label}</span>
  <h3>{title}</h3>
  <p class="muted">{summary}</p>
  <span class="chips">{stack.slice(0, 3).map((s) => <span class="chip">{s}</span>)}</span>
  <span class="more">Read the case study →</span>
</a>
<style>
  .case { display: flex; flex-direction: column; gap: 6px; text-decoration: none; transition: border-color .2s, transform .2s; }
  .case:hover { border-color: var(--accent); transform: translateY(-2px); color: inherit; }
  .metric { font-size: 2.4rem; }
  .label { font-size: .85rem; margin-bottom: 12px; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 12px; }
  .more { margin-top: auto; font-weight: 600; color: var(--accent); font-size: .92rem; }
</style>
