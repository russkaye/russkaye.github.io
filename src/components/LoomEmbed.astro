---
interface Props { url: string; title: string }
const { url, title } = Astro.props;
const embed = url.replace('loom.com/share/', 'loom.com/embed/');
---
<figure class="loom">
  <div class="frame"><iframe src={embed} title={`Video walkthrough: ${title}`} loading="lazy" allowfullscreen></iframe></div>
  <figcaption class="muted">Walkthrough presented by Juno, one of my AI agents · <a href={url}>Open on Loom</a></figcaption>
</figure>
<style>
  .frame { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--border); background: var(--surface); }
  .frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  figcaption { font-size: .85rem; margin-top: 8px; }
  .loom { margin: 0 0 32px; }
</style>
