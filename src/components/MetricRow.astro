---
interface Props { metrics: { value: string; label: string }[] }
const { metrics } = Astro.props;
---
<dl class="metrics">
  {metrics.map((m) => (<div><dt class="num">{m.value}</dt><dd class="muted">{m.label}</dd></div>))}
</dl>
<style>
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 20px; margin: 28px 0; }
  .metrics dt { font-size: clamp(2rem, 4vw, 2.8rem); }
  .metrics dd { margin: 6px 0 0; font-size: .9rem; }
</style>
